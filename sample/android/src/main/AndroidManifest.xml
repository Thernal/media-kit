<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declaring CAMERA makes Android require it for the camera app too; the kit then asks for it
         (its minimal CameraPermission). Without this line the camera needs no permission at all. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- CAMERA would otherwise make Play require a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="media-kit"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
